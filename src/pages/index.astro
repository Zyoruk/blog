---
import { Image } from "astro:assets";
import avatar from "../assets/zyoruk.png";
import PostList from "../components/PostList.astro";
import Base from "../layouts/Base.astro";
import { getWriting } from "../writing";

const latest = (await getWriting()).slice(0, 5);

const focus = [
	{
		area: "AI",
		detail: "Building with LLMs and agents, and using AI to ship faster without lowering the bar.",
	},
	{
		area: "Cloud",
		detail:
			"AWS infrastructure that is boring to operate: managed services, clear ownership, low toil.",
	},
	{
		area: "Architecture",
		detail: "Distributed systems that balance performance with code people can still change.",
	},
	{
		area: "Full-stack web",
		detail: "React, Next.js, TypeScript and Node.js, with care for performance and accessibility.",
	},
	{
		area: "Engineering leadership",
		detail: "Hiring, mentoring and leading teams across time zones.",
	},
];
---

<Base
	title="Zyoruk | Software Engineer"
	description="Zyoruk is a software engineer writing about AI, cloud, architecture and engineering teams."
>
	<section class="intro">
		<Image src={avatar} alt="Zyoruk" width={96} height={96} class="avatar" loading="eager" />
		<div>
			<h1>Zyoruk</h1>
			<p class="lead">
				Software engineer in San José, Costa Rica. I write code that is intentional and easy to build on,
				and I write here to think out loud about systems, teams and building with AI.
			</p>
			<p class="mono">
				<a href="/now">what I'm doing now</a> · <a href="/uses">what I use</a>
			</p>
		</div>
	</section>

	<h2 class="kicker">focus</h2>
	<dl class="focus">
		{focus.map(({ area, detail }) => (
			<div>
				<dt>{area}</dt>
				<dd>{detail}</dd>
			</div>
		))}
	</dl>

	<h2 class="kicker">latest</h2>
	<PostList items={latest} />
	<p class="more mono"><a href="/blog">all writing →</a></p>
</Base>

<style>
	.intro {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
	}

	.intro :global(.avatar) {
		flex-shrink: 0;
		border-radius: 50%;
		border: 1px solid var(--border);
	}

	h1 {
		margin-bottom: 0.5rem;
	}

	.lead {
		font-size: 1.125rem;
	}

	.focus {
		margin: 0;
	}

	.focus div {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 1rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--border);
	}

	dt {
		color: var(--ink);
		font-weight: 500;
	}

	dd {
		margin: 0;
		color: var(--muted);
	}

	.more {
		margin-top: 1rem;
	}

	@media (max-width: 560px) {
		.intro {
			flex-direction: column;
			gap: 1rem;
		}

		.focus div {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
	}
</style>
