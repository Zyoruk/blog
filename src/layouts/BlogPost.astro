---
import FormattedDate from "../components/FormattedDate.astro";
import { type Kind, transitionName } from "../writing";
import Base from "./Base.astro";

// Used by essays and notes (props spread from the collection entry) and by
// Markdown pages like /now and /uses (which receive `frontmatter` instead).
interface Data {
	title: string;
	description?: string;
	pubDate?: Date | string;
	updatedDate?: Date | string;
	status?: string;
	tags?: string[];
	kind?: Kind;
}

const data: Data = Astro.props.frontmatter ?? Astro.props;
const { title, description = title, status, tags, kind } = data;
const pubDate = data.pubDate && new Date(data.pubDate);
const updatedDate = data.updatedDate && new Date(data.updatedDate);
---

<Base title={`${title} | Zyoruk`} description={description}>
	<article>
		<header>
			<h1 style={kind && `view-transition-name: ${transitionName(Astro.url.pathname)}`}>{title}</h1>
			<p class="mono meta">
				{kind && <span class="kind">{kind}</span>}
				{pubDate && <FormattedDate date={pubDate} />}
				{updatedDate && <span>updated <FormattedDate date={updatedDate} /></span>}
				{status && <span class={`status ${status}`}>{status}</span>}
				{tags?.map((tag) => <span>#{tag}</span>)}
			</p>
		</header>

		<div class="prose">
			<slot />
		</div>

		{kind && (
			<footer>
				<a href="/blog" class="mono">← all writing</a>
			</footer>
		)}
	</article>
</Base>

<style>
	header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	h1 {
		margin-bottom: 0.75rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		margin: 0;
	}

	.kind {
		color: var(--accent-2);
	}

	.status {
		padding: 0 0.4rem;
		border: 1px solid var(--border);
		border-radius: 4px;
	}

	.status.stable {
		color: var(--accent-2);
	}

	.status.draft {
		border-style: dashed;
	}

	.prose :global(h2) {
		font-size: 1.35rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	footer a {
		color: var(--muted);
		text-decoration: none;
	}

	footer a:hover {
		color: var(--accent);
	}
</style>
