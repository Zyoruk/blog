---
import FormattedDate from "../components/FormattedDate.astro";
import { type Kind, kindLabel, transitionName } from "../writing";
import Base from "./Base.astro";

// Used by essays and notes (props spread from the collection entry) and by
// Markdown pages like /now and /uses (which receive `frontmatter` instead).
interface Data {
	title: string;
	description?: string;
	pubDate?: Date | string;
	updatedDate?: Date | string;
	status?: string;
	tags?: string[];
	kind?: Kind;
	// Case studies.
	role?: string;
	period?: string;
	// Guides (required) and any post that cites published work.
	sources?: { title: string; url: string; author?: string; publisher?: string; date?: Date }[];
}

const data: Data = Astro.props.frontmatter ?? Astro.props;
const { title, description = title, status, tags, kind, role, period, sources } = data;
const pubDate = data.pubDate && new Date(data.pubDate);
const updatedDate = data.updatedDate && new Date(data.updatedDate);
---

<Base title={`${title} | Zyoruk`} description={description}>
	<article>
		<header>
			<h1 style={kind && `view-transition-name: ${transitionName(Astro.url.pathname)}`}>{title}</h1>
			<p class="mono meta">
				{kind && <span class="kind">{kindLabel(kind)}</span>}
				{pubDate && <FormattedDate date={pubDate} />}
				{updatedDate && <span>updated <FormattedDate date={updatedDate} /></span>}
				{status && <span class={`status ${status}`}>{status}</span>}
				{tags?.map((tag) => <span>#{tag}</span>)}
			</p>
			<p class="print-only">{new URL(Astro.url.pathname, Astro.site ?? Astro.url).href}</p>
			{kind && (
				<button type="button" class="save-pdf mono" data-print>
					Save as PDF
				</button>
			)}
			{(role || period) && (
				<p class="mono meta case">
					{role && <span>role: {role}</span>}
					{period && <span>period: {period}</span>}
				</p>
			)}
		</header>

		<div class="prose">
			<slot />
		</div>

		{sources && sources.length > 0 && (
			<section class="sources" aria-labelledby="sources-heading">
				<h2 id="sources-heading">Sources</h2>
				<ol>
					{sources.map((source) => (
						<li>
							<a href={source.url}>{source.title}</a>
							{[source.author, source.publisher, source.date?.getUTCFullYear()]
								.filter(Boolean)
								.map((part) => <span>, {part}</span>)}
						</li>
					))}
				</ol>
			</section>
		)}

		<script>
			document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach((button) => {
				button.addEventListener("click", () => window.print());
			});
		</script>

		{kind && (
			<footer>
				<a href="/blog" class="mono">← all writing</a>
			</footer>
		)}
	</article>
</Base>

<style>
	header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	h1 {
		margin-bottom: 0.75rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		margin: 0;
	}

	.kind {
		color: var(--accent-2);
	}

	.status {
		padding: 0 0.4rem;
		border: 1px solid var(--border);
		border-radius: 4px;
	}

	.status.stable {
		color: var(--accent-2);
	}

	.status.draft {
		border-style: dashed;
	}

	.prose :global(h2) {
		font-size: 1.35rem;
	}

	.case {
		margin-top: 0.4rem;
	}

	.sources {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		font-size: 0.9375rem;
	}

	.sources h2 {
		font-size: 1rem;
		font-family: var(--mono);
		font-weight: 500;
		color: var(--muted);
	}

	.sources li {
		margin-bottom: 0.4rem;
		overflow-wrap: anywhere;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.save-pdf {
		margin-top: 1rem;
		font-size: 0.8125rem;
		background: none;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.2rem 0.6rem;
		cursor: pointer;
	}

	.save-pdf:hover {
		color: var(--ink);
		border-color: var(--muted);
	}

	.prose :global(.footnotes) {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		font-size: 0.875rem;
		color: var(--muted);
	}

	footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	footer a {
		color: var(--muted);
		text-decoration: none;
	}

	footer a:hover {
		color: var(--accent);
	}
</style>
