---
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<nav>
		<a href="/" class="brand">
			<img src="/avatar.svg" alt="" width="28" height="28" />
			<span>~/zyoruk</span>
		</a>
		<div class="links">
			<HeaderLink href="/blog">writing</HeaderLink>
			<HeaderLink href="/now">now</HeaderLink>
			<HeaderLink href="/uses">uses</HeaderLink>
			<a href="/rss.xml" class="rss">rss</a>
			<button type="button" id="theme-toggle" aria-label="Toggle dark mode">
				<span class="light-only" aria-hidden="true">☾</span>
				<span class="dark-only" aria-hidden="true">☀</span>
			</button>
		</div>
	</nav>
</header>

<script>
	const root = document.documentElement;
	document.getElementById("theme-toggle")?.addEventListener("click", () => {
		const isDark =
			root.dataset.theme === "dark" ||
			(!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
		const next = isDark ? "light" : "dark";
		root.dataset.theme = next;
		try {
			localStorage.setItem("theme", next);
		} catch {}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 0 1rem;
		height: 3.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--mono);
		font-size: 0.875rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--ink);
		font-weight: 500;
		text-decoration: none;
	}

	.brand img {
		border-radius: 6px;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 1.1rem;
	}

	.rss {
		color: var(--muted);
		text-decoration: none;
	}

	.rss:hover {
		color: var(--ink);
	}

	button {
		background: none;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--muted);
		width: 2rem;
		height: 2rem;
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
	}

	button:hover {
		color: var(--ink);
		border-color: var(--muted);
	}

	.dark-only {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme="light"])) .light-only {
			display: none;
		}
		:global(:root:not([data-theme="light"])) .dark-only {
			display: inline;
		}
	}

	:global(:root[data-theme="dark"]) .light-only {
		display: none;
	}

	:global(:root[data-theme="dark"]) .dark-only {
		display: inline;
	}

	@media (max-width: 480px) {
		.brand span,
		.rss {
			display: none;
		}
	}
</style>
