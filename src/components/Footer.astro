---
const today = new Date();
---

<footer>
	<div>
		<span>© {today.getFullYear()} Zyoruk · San José, Costa Rica</span>
		<span>
			<a href="https://github.com/Zyoruk">github</a> ·
			<a href="/rss.xml">rss</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: var(--muted);
	}

	div {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1.5rem 1rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
	}

	a {
		color: var(--muted);
	}

	a:hover {
		color: var(--ink);
	}
</style>
