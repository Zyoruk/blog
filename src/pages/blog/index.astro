---
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";
import { KINDS, type Kind, getWriting, kindLabel } from "../../writing";

const items = await getWriting();
// Only offer the kinds that have something published.
const kinds = (Object.keys(KINDS) as Kind[]).filter((kind) =>
	items.some((item) => item.kind === kind)
);
const filters = [
	{ value: "all", label: "all" },
	...kinds.map((kind) => ({ value: kind, label: kindLabel(kind) })),
	...[...new Set(items.flatMap((item) => item.tags ?? []))].map((tag) => ({
		value: tag,
		label: tag,
	})),
];
---

<Base title="Writing | Zyoruk" description="Essays, notes, guides and case studies on AI, cloud, architecture and engineering teams.">
	<h1>Writing</h1>
	<p>
		Essays are longer and more finished. Notes are short and rough. Guides explain a topic with
		sources. Case studies walk through one real piece of work. Each one may show a status:
		<span class="mono">draft</span>, <span class="mono">evolving</span> or <span class="mono">stable</span>.
	</p>

	<div class="filters" role="group" aria-label="Filter writing">
		{filters.map((filter) => (
			<button type="button" data-filter={filter.value} aria-pressed={filter.value === "all" ? "true" : "false"}>
				{filter.label}
			</button>
		))}
	</div>

	<PostList items={items} />
</Base>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>(".filters button");
	const rows = document.querySelectorAll<HTMLElement>(".post-list li");
	for (const button of buttons) {
		button.addEventListener("click", () => {
			const filter = button.dataset.filter!;
			for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
			for (const row of rows) {
				row.hidden = filter !== "all" && !row.dataset.tags!.split(" ").includes(filter);
			}
		});
	}
	// Tag nodes in the home page graph link here as /blog?tag=<tag>.
	const tag = new URLSearchParams(location.search).get("tag");
	[...buttons].find((button) => button.dataset.filter === tag)?.click();
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 2rem 0 1rem;
	}

	button {
		font-family: var(--mono);
		font-size: 0.8125rem;
		background: none;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.2rem 0.6rem;
		cursor: pointer;
	}

	button:hover {
		color: var(--ink);
	}

	button[aria-pressed="true"] {
		color: var(--accent);
		border-color: var(--accent);
		background: var(--accent-bg);
	}
</style>
